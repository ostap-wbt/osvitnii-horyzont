# Налаштування порту сервера
PORT=3000

# Підключення до бази даних MongoDB Atlas
# Формат підключення для акаунту ostap.yunak@gmail.com:
# mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/osvitnii_horyzont?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ostap_admin:<PASSWORD>@cluster0.mongodb.net/osvitnii_horyzont?retryWrites=true&w=majority

# Середовище запуску (production або development)
NODE_ENV=production
